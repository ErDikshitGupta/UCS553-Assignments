import java.util.*;

class Course {
    String courseCode;
    int capacity;
    HashSet<String> enrolledStudents;
    ArrayList<String> prerequisites;
    LinkedList<String> waitlist;

    Course(String courseCode, int capacity, ArrayList<String> prerequisites) {
        this.courseCode = courseCode;
        this.capacity = capacity;
        this.prerequisites = prerequisites;
        this.enrolledStudents = new HashSet<>();
        this.waitlist = new LinkedList<>();
    }
}

public class CourseRegistrationPortal {

    HashMap<String, Course> courses = new HashMap<>();
    HashMap<String, HashSet<String>> completedCourses = new HashMap<>();
    void addCourse(String code, int capacity, ArrayList<String> prerequisites) {
        courses.put(code, new Course(code, capacity, prerequisites));
        System.out.println("Course added: " + code);
    }
    void completeCourse(String studentId, String courseCode) {
        completedCourses
            .computeIfAbsent(studentId, k -> new HashSet<>())
            .add(courseCode);
    }

    boolean hasPrerequisites(String studentId, Course course) {
        HashSet<String> completed = completedCourses.getOrDefault(
            studentId, new HashSet<>()
        );

        return completed.containsAll(course.prerequisites);
    }


    void registerStudent(String studentId, String courseCode) {
        Course course = courses.get(courseCode);

        if (course == null) {
            System.out.println("Course not found: " + courseCode);
            return;
        }

        if (!hasPrerequisites(studentId, course)) {
            System.out.println(studentId +
                " has not completed prerequisites for " + courseCode);
            return;
        }

        if (course.enrolledStudents.contains(studentId)) {
            System.out.println(studentId + " is already enrolled.");
            return;
        }

        if (course.waitlist.contains(studentId)) {
            System.out.println(studentId + " is already waitlisted.");
            return;
        }

        if (course.enrolledStudents.size() < course.capacity) {
            course.enrolledStudents.add(studentId);
            System.out.println(studentId +
                " registered successfully for " + courseCode);
        } else {
            course.waitlist.addLast(studentId);
            System.out.println(studentId +
                " added to waitlist for " + courseCode);
        }
    }

    void dropStudent(String studentId, String courseCode) {
        Course course = courses.get(courseCode);

        if (course == null) {
            System.out.println("Course not found.");
            return;
        }

        if (!course.enrolledStudents.remove(studentId)) {
            System.out.println(studentId + " is not enrolled.");
            return;
        }

        System.out.println(studentId + " dropped " + courseCode);

        if (!course.waitlist.isEmpty()) {
            String nextStudent = course.waitlist.removeFirst();
            course.enrolledStudents.add(nextStudent);

            System.out.println(nextStudent +
                " promoted from waitlist to " + courseCode);
        }
    }
    void displayCourse(String courseCode) {
        Course course = courses.get(courseCode);

        if (course == null) {
            System.out.println("Course not found.");
            return;
        }

        System.out.println("\nCourse: " + course.courseCode);
        System.out.println("Capacity: " + course.capacity);
        System.out.println("Prerequisites: " + course.prerequisites);
        System.out.println("Enrolled students: " +
            course.enrolledStudents);
        System.out.println("Waitlist: " + course.waitlist);
    }

    public static void main(String[] args) {
        CourseRegistrationPortal portal =
            new CourseRegistrationPortal();

        portal.addCourse("JAVA101", 2, new ArrayList<>());
        portal.addCourse("JAVA201", 2,
            new ArrayList<>(Arrays.asList("JAVA101")));

        portal.completeCourse("S101", "JAVA101");
        portal.completeCourse("S102", "JAVA101");
        portal.completeCourse("S103", "JAVA101");

        portal.registerStudent("S101", "JAVA201");
        portal.registerStudent("S102", "JAVA201");
        portal.registerStudent("S103", "JAVA201");

        portal.displayCourse("JAVA201");
        portal.dropStudent("S101", "JAVA201");
        portal.displayCourse("JAVA201");
    }
}



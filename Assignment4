import java.util.*;

class Song {
    String title;
    String artist;

    Song(String title, String artist) {
        this.title = title;
        this.artist = artist;
    }

    @Override
    public boolean equals(Object obj) {
        if (this == obj) return true;
        if (!(obj instanceof Song)) return false;

        Song other = (Song) obj;
        return title.equalsIgnoreCase(other.title)
            && artist.equalsIgnoreCase(other.artist);
    }

    @Override
    public int hashCode() {
        return Objects.hash(
            title.toLowerCase(),
            artist.toLowerCase()
        );
    }

    @Override
    public String toString() {
        return title + " - " + artist;
    }
}

public class MediaPlayerQueue {

    LinkedList<Song> playlist = new LinkedList<>();
    LinkedList<Song> recentHistory = new LinkedList<>();

    // Add a song at the end
    void addSong(Song song) {
        playlist.addLast(song);
        System.out.println("Added: " + song);
    }

    // Add a priority song at the beginning
    void addPrioritySong(Song song) {
        playlist.addFirst(song);
        System.out.println("Priority song added: " + song);
    }

    // Insert a song at a specific position (zero-based index)
    void addSongAt(int index, Song song) {
        if (index < 0 || index > playlist.size()) {
            System.out.println("Invalid playlist position.");
            return;
        }

        playlist.add(index, song);
        System.out.println("Inserted at position " + index +
            ": " + song);
    }

    // Remove the first occurrence of a song
    void removeSong(Song song) {
        if (playlist.remove(song)) {
            System.out.println("Removed: " + song);
        } else {
            System.out.println("Song not found: " + song);
        }
    }

    // Remove duplicate songs while preserving first occurrences
    void removeDuplicates() {
        HashSet<Song> seen = new HashSet<>();
        Iterator<Song> iterator = playlist.iterator();

        while (iterator.hasNext()) {
            Song song = iterator.next();

            if (!seen.add(song)) {
                iterator.remove();
            }
        }

        System.out.println("Duplicate songs removed.");
    }

    // Play a song and update recent history
    void playSong(Song song) {
        if (playlist.contains(song)) {
            recentHistory.remove(song);
            recentHistory.addFirst(song);

            System.out.println("Now playing: " + song);
        } else {
            System.out.println("Song is not in the playlist.");
        }
    }

    // Display playlist from beginning to end
    void displayForward() {
        System.out.println("\nPlaylist (Forward):");

        ListIterator<Song> iterator = playlist.listIterator();

        while (iterator.hasNext()) {
            System.out.println(iterator.next());
        }
    }

    // Display playlist from end to beginning
    void displayBackward() {
        System.out.println("\nPlaylist (Backward):");

        ListIterator<Song> iterator =
            playlist.listIterator(playlist.size());

        while (iterator.hasPrevious()) {
            System.out.println(iterator.previous());
        }
    }

    // Display recently played songs
    void displayRecentHistory() {
        System.out.println("\nRecently Played:");

        for (Song song : recentHistory) {
            System.out.println(song);
        }
    }

    public static void main(String[] args) {
        MediaPlayerQueue player = new MediaPlayerQueue();

        Song s1 = new Song("Perfect", "Ed Sheeran");
        Song s2 = new Song("Believer", "Imagine Dragons");
        Song s3 = new Song("Shape of You", "Ed Sheeran");
        Song s4 = new Song("Believer", "Imagine Dragons");

        // Add songs
        player.addSong(s1);
        player.addSong(s2);
        player.addSong(s3);
        player.addSong(s4); // Duplicate

        // Insert a song at a particular position
        player.addSongAt(1,
            new Song("Blinding Lights", "The Weeknd"));

        // Add a priority song at the beginning
        player.addPrioritySong(
            new Song("Levitating", "Dua Lipa"));

        // Remove duplicates
        player.removeDuplicates();

        // Display playlist in both directions
        player.displayForward();
        player.displayBackward();

        // Play songs and update recent history
        player.playSong(s1);
        player.playSong(s3);
        player.playSong(s2);

        // Display recent history
        player.displayRecentHistory();

        // Remove a song
        player.removeSong(s1);

        // Display final playlist
        player.displayForward();
    }
}

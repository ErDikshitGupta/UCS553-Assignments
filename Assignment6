import java.io.*;
import java.util.Scanner;

public class FileHandling {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        // Writing student details into a text file
        try (FileWriter fw = new FileWriter("students.txt")) {

            System.out.print("Enter Student ID: ");
            String id = sc.nextLine();

            System.out.print("Enter Student Name: ");
            String name = sc.nextLine();

            System.out.print("Enter Student Course: ");
            String course = sc.nextLine();

            System.out.print("Enter Student Marks: ");
            String marks = sc.nextLine();

            fw.write("Student ID: " + id + "\n");
            fw.write("Student Name: " + name + "\n");
            fw.write("Course: " + course + "\n");
            fw.write("Marks: " + marks + "\n");

            System.out.println("\nStudent details saved successfully.");

        } catch (IOException e) {
            System.out.println("Error writing file: " + e.getMessage());
        }

        // Reading student details from text file
        try (FileReader fr = new FileReader("students.txt")) {

            int ch;

            System.out.println("\nStudent Records:");

            while ((ch = fr.read()) != -1) {
                System.out.print((char) ch);
            }

        } catch (IOException e) {
            System.out.println("Error reading file: " + e.getMessage());
        }

        // Copying a binary file using byte streams
        try (FileInputStream fis = new FileInputStream("source.bin");
             FileOutputStream fos = new FileOutputStream("copy.bin")) {

            int data;

            while ((data = fis.read()) != -1) {
                fos.write(data);
            }

            System.out.println("\nBinary file copied successfully.");

        } catch (IOException e) {
            System.out.println("Error copying binary file: " + e.getMessage());
        }

        sc.close();
    }
}



import java.io.*;

public class LogAnalyzer {

    public static void main(String[] args) {

        int totalEntries = 0;
        int errorCount = 0;
        int warningCount = 0;

        try (
            BufferedReader br = new BufferedReader(
                new FileReader("application.log"));

            BufferedWriter bw = new BufferedWriter(
                new FileWriter("filtered.log"))
        ) {

            String line;

            while ((line = br.readLine()) != null) {

                totalEntries++;

                if (line.toUpperCase().contains("ERROR")) {

                    bw.write(line);
                    bw.newLine();
                    errorCount++;

                } else if (line.toUpperCase().contains("WARNING")) {

                    bw.write(line);
                    bw.newLine();
                    warningCount++;

                }
            }

            System.out.println("Log Analysis Completed!");
            System.out.println("Total Log Entries: " + totalEntries);
            System.out.println("Total Errors: " + errorCount);
            System.out.println("Total Warnings: " + warningCount);

            System.out.println(
                "Filtered entries saved in filtered.log");

        } catch (IOException e) {

            System.out.println("File Error: " + e.getMessage());

        }
    }
}



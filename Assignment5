import java.util.Optional;
import java.util.Objects;

class Result<T extends Number> {
    private final T marks;

    public Result(T marks) {
        this.marks = Objects.requireNonNull(
                marks, "Marks cannot be null");
    }

    // Calculate percentage assuming maximum marks are 100
    public double getPercentage() {
        return marks.doubleValue();
    }

    // Check whether the student passed
    public boolean hasPassed(double threshold) {
        return getPercentage() >= threshold;
    }

    // Return marks using Optional
    public Optional<T> getMarks() {
        return Optional.ofNullable(marks);
    }

    public void displayResult(double threshold) {
        System.out.println("Marks: " + getMarks().orElse(null));
        System.out.println("Percentage: " + getPercentage() + "%");

        if (hasPassed(threshold)) {
            System.out.println("Result: Pass");
        } else {
            System.out.println("Result: Fail");
        }
    }
}

public class Q3 {
    public static void main(String[] args) {
        Result<Integer> student1 = new Result<>(85);
        Result<Double> student2 = new Result<>(35.5);

        System.out.println("Student 1:");
        student1.displayResult(40);

        System.out.println("\nStudent 2:");
        student2.displayResult(40);
    }
}



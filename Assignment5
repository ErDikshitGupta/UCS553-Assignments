import java.time.LocalDate;
import java.time.LocalTime;
import java.time.temporal.ChronoUnit;
import java.util.Optional;
import java.util.Scanner;

public class Q4 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // 1. Accept event details
        System.out.print("Enter event name: ");
        String name = sc.nextLine();

        System.out.print("Enter event date (YYYY-MM-DD): ");
        LocalDate date = LocalDate.parse(sc.nextLine());

        System.out.print("Enter start time (HH:MM): ");
        LocalTime startTime = LocalTime.parse(sc.nextLine());

        System.out.print("Enter venue (leave blank if unknown): ");
        String venueInput = sc.nextLine();

        Optional<String> venue = venueInput.isBlank()
                ? Optional.empty()
                : Optional.of(venueInput);

        // 2. Display event details
        System.out.println("\n--- Event Details ---");
        System.out.println("Name: " + name);
        System.out.println("Date: " + date);
        System.out.println("Start Time: " + startTime);

        // 6. Display venue or default message
        System.out.println("Venue: "
                + venue.orElse("Venue not specified"));

        // 3. Check event date
        LocalDate today = LocalDate.now();

        if (date.isAfter(today)) {
            System.out.println("Event is in the future.");
        } else if (date.isEqual(today)) {
            System.out.println("Event is today.");
        } else {
            System.out.println("Event is in the past.");
        }

        // 4. Calculate days remaining
        long daysRemaining = ChronoUnit.DAYS.between(today, date);
        System.out.println("Days remaining: " + daysRemaining);

        // 5. Calculate end time after two hours
        LocalTime endTime = startTime.plusHours(2);
        System.out.println("End Time: " + endTime);

        sc.close();
    }
}



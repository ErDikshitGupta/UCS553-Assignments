import java.util.Optional;
import java.util.Objects;

class Utility {

    // 1. Check whether two objects are equal
    public static <T> boolean isEqual(T a, T b) {
        return Objects.equals(a, b);
    }

    // 2. Return the value or a default value
    public static <T> T getDefault(
            Optional<T> value, T defaultValue) {
        return value.orElse(defaultValue);
    }

    // 3. Return the larger of two comparable objects
    public static <T extends Comparable<T>> T max(T a, T b) {
        return a.compareTo(b) >= 0 ? a : b;
    }

    // 4. Check whether an object is null
    public static boolean isNull(Object obj) {
        return obj == null;
    }
}

public class Q5 {
    public static void main(String[] args) {

        // Test with Strings
        System.out.println("Strings equal: "
                + Utility.isEqual("Java", "Java"));

        System.out.println("String default: "
                + Utility.getDefault(
                        Optional.empty(), "Default"));

        System.out.println("Larger String: "
                + Utility.max("Apple", "Banana"));

        // Test with Integers
        System.out.println("Integers equal: "
                + Utility.isEqual(10, 10));

        System.out.println("Integer default: "
                + Utility.getDefault(
                        Optional.of(50), 0));

        System.out.println("Larger Integer: "
                + Utility.max(25, 40));

        // Test null checking
        String text = null;
        Integer number = 100;

        System.out.println("Is text null? "
                + Utility.isNull(text));

        System.out.println("Is number null? "
                + Utility.isNull(number));
    }
}

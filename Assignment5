import java.util.Optional;

public class Q2 {
    public static void main(String[] args) {

        // 1. Create an Optional containing an email
        Optional<String> email =
                Optional.of("student@gmail.com");

        // 2. Create an empty Optional
        Optional<String> emptyEmail = Optional.empty();

        // 3. Display email using isPresent()
        if (email.isPresent()) {
            System.out.println("Email: " + email.get());
        }

        // 4. Use orElse() to provide a default email
        String defaultEmail =
                emptyEmail.orElse("default@gmail.com");

        System.out.println("Default Email: " + defaultEmail);

        // 5. Use orElseThrow() to handle a missing email
        try {
            String result = emptyEmail.orElseThrow(
                    () -> new IllegalArgumentException(
                            "Email is missing")
            );

            System.out.println(result);
        } catch (IllegalArgumentException e) {
            System.out.println("Exception: " + e.getMessage());
        }
    }
}


